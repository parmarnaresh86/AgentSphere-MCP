      "U_PurQte": "Purchase quotation reference",
      "U_GRNNO": "GRN / goods receipt note number",
      "U_SERVCALL": "Service call reference",
      "U_SENTWP": "Sent via WhatsApp flag"
    },
    "lineLevel": {
      "U_PROJECT": "Project code on line",
      "U_SO_NUM": "Sales order reference on PO line",
      "U_PRO_NUM": "Production order number",
      "U_SSCCNO": "SSCC barcode number",
      "U_WASTEQTY": "Waste quantity",
      "U_beas_art": "BEAS article reference",
      "U_beas_prjuid": "BEAS project UID"
    }
  },

  "commonQueryPatterns": {
    "openSalesOrders": {
      "endpoint": "/Orders",
      "params": { "$filter": "DocumentStatus eq 'bost_Open' and Cancelled eq 'tNO'", "$select": "DocEntry,DocNum,DocDate,DocDueDate,CardCode,CardName,DocTotal,SalesPersonCode" }
    },
    "overdueInvoices": {
      "endpoint": "/Invoices",
      "params": { "$filter": "DocumentStatus eq 'bost_Open' and DocDueDate lt '2026-01-01' and Cancelled eq 'tNO'", "$select": "DocEntry,DocNum,DocDate,DocDueDate,CardCode,CardName,DocTotal,PaidToDate,SalesPersonCode", "$orderby": "DocDueDate asc" }
    },
    "openPurchaseOrders": {
      "endpoint": "/PurchaseOrders",
      "params": { "$filter": "DocumentStatus eq 'bost_Open' and Cancelled eq 'tNO'", "$select": "DocEntry,DocNum,DocDate,DocDueDate,CardCode,CardName,DocTotal" }
    },
    "itemStockLookup": {
      "endpoint": "/Items('{ItemCode}')",
      "params": { "$select": "ItemCode,ItemName,QuantityOnStock,QuantityOrderedByCustomers,QuantityOrderedFromVendors,MinInventory,DefaultWarehouse,Mainsupplier,LeadTime,MinOrderQuantity,CostAccountingMethod" }
    },
    "supplierList": {
      "endpoint": "/BusinessPartners",
      "params": { "$filter": "CardType eq 'cSupplier' and Valid eq 'tYES'", "$select": "CardCode,CardName,Phone1,EmailAddress,Currency,CurrentAccountBalance" }
    },
    "customerList": {
      "endpoint": "/BusinessPartners",
      "params": { "$filter": "CardType eq 'cCustomer' and Valid eq 'tYES'", "$select": "CardCode,CardName,Phone1,EmailAddress,CreditLimit,CurrentAccountBalance,SalesPersonCode" }
    },
    "openPurchaseRequests": {
      "endpoint": "/PurchaseRequests",
      "params": { "$filter": "DocumentStatus eq 'bost_Open'", "$select": "DocEntry,DocNum,DocDate,DocDueDate,Requester,RequesterName,DocTotal,Comments" }
    },
    "journalEntriesByDate": {
      "endpoint": "/JournalEntries",
      "params": { "$filter": "ReferenceDate ge '2025-01-01' and ReferenceDate le '2025-12-31'", "$select": "JdtNum,ReferenceDate,Memo,Reference,OriginalJournal,Original", "$orderby": "ReferenceDate desc" }
    }
  }
}
