# =============================================================================
#  AgentSphere AI for SAP Business One - configuration
#
#  1. Copy this file to .env (One-Click-Install.bat does it for you)
#  2. Fill in the values below - this is the ONLY file you need to edit
#  3. Right-click One-Click-Install.bat -> Run as administrator
# =============================================================================

# -- SAP Business One Service Layer (required) --------------------------------
SL_BASE_URL=https://your-sap-server:50000/b1s/v1
SL_COMPANY=SBODEMOUS
SL_USER=manager
SL_PASSWORD=

# Legacy names - leave blank, the installer copies the SL_* values into them
SAP_B1_BASE_URL=
SAP_B1_COMPANY=
SAP_B1_USER=
SAP_B1_PASSWORD=

# Service Layer often uses a self-signed certificate. 0 = accept it.
NODE_TLS_REJECT_UNAUTHORIZED=0

# -- Direct HANA database access (optional - DB SQL mode, analytics) ----------
# Leave HANA_HOST blank to skip.
HANA_HOST=
# Single-container HANA: 30015. Multi-tenant HANA 2.0: usually 30041 (or 30013 + HANA_TENANT)
HANA_PORT=30015
# Tenant database name - only for multi-tenant systems connected via the SYSTEMDB port
HANA_TENANT=
# Company schema(s) the app may read. Comma-separate several companies. Blank = SL_COMPANY
HANA_SCHEMA=

# HANA administrator - used ONCE by the installer to create the app user below.
# The installer blanks HANA_ADMIN_PASSWORD after the user is created.
HANA_ADMIN_USER=SYSTEM
HANA_ADMIN_PASSWORD=

# Read-only user the app connects with. Created by the installer.
# Leave HANA_PASSWORD blank to have a strong password generated for you.
HANA_USER=AGENTSPHERE_RO
HANA_PASSWORD=

# -- AI provider (optional - without it the app runs in rule-based mode) ------
# anthropic | gpt | azure
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Azure OpenAI GPT-4o (AI_PROVIDER=gpt)
AZURE_GPT_ENDPOINT=
# Claude on Azure AI Services (AI_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_CLAUDE_MODEL=
# Key for either Azure option
AZURE_OPENAI_API_KEY=

# -- Web server ----------------------------------------------------------------
CHAT_PORT=3000
DEMO_MODE=false

# -- Cost-centre dimension names (rename to match your SAP B1 setup) ----------
DIM1_NAME=
DIM2_NAME=
DIM3_NAME=
DIM4_NAME=
DIM5_NAME=

# -- Mail PO -> Sales Order (optional) -----------------------------------------
# Gmail / Office 365 with 2FA need an app password, not the normal password
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_TLS=true
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_TLS=false
MAIL_USER=
MAIL_PASS=
MAIL_FOLDER=INBOX
MAIL_POLL_MS=60000

# -- Supplier GSTIN check (optional, key from gstinapi.in) ---------------------
GSTIN_API_KEY=

# -- Password encryption key (64 hex chars). Blank = generated by the installer.
DB_ENCRYPT_KEY=
