SAP_B1_BASE_URL=https://your-sap-server:50000/b1s/v1
SAP_B1_COMPANY=SBODemoUS
SAP_B1_USER=manager
SAP_B1_PASSWORD=yourpassword
NODE_TLS_REJECT_UNAUTHORIZED=0

# DB_ENCRYPT_KEY — 64-char hex (32 bytes) for AES-256-GCM password encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank to disable password encryption (passwords stored as plain text).
DB_ENCRYPT_KEY=

# GSTIN_API_KEY — API key from gstinapi.in, used by the Supplier Master GSTIN Check panel
GSTIN_API_KEY=