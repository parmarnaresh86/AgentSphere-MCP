{
  "_meta": {
    "description": "SAP B1 Service Layer OData schema — fields read from live WMS_DEV_UK company",
    "baseUrl": "/b1s/v1",
    "generatedOn": "2026-05-15",
    "statusValues": {
      "DocumentStatus": "'bost_Open' | 'bost_Close'",
      "Cancelled": "'tYES' | 'tNO'",
      "CardType": "'cCustomer' | 'cSupplier' | 'cLead'",
      "InvoiceType_Payment": "'it_Invoice' | 'it_PurchaseInvoice'"
    },
    "baseTypeCodes": {
      "23": "Quotation (oQuotation)",
      "17": "Sales Order (oOrders)",
      "15": "Delivery Note (oDeliveryNotes)",
      "13": "AR Invoice (oInvoices)",
      "20": "GRPO / Purchase Delivery Note (oPurchaseDeliveryNotes)",
      "22": "Purchase Order (oPurchaseOrders)",
      "1470000113": "Purchase Request (oPurchaseRequest)",
      "-1": "No base document"
    },
    "odataFilterHints": {
      "dates": "Use ISO format: DocDate ge '2025-01-01' and DocDate le '2025-12-31'",
      "stringContains": "contains(CardName,'smith')",
      "enumEquals": "DocumentStatus eq 'bost_Open'",
      "andOr": "CardType eq 'cCustomer' and Valid eq 'tYES'"
    }
  },

  "commonDocumentHeader": {
    "description": "Shared header fields on all transactional documents (Quotations, Orders, Invoices, DeliveryNotes, PurchaseOrders, etc.)",
    "fields": {
      "DocEntry": "int — primary key (use in URLs like /Orders(123))",
      "DocNum": "int — user-visible document number",
      "DocDate": "DateTime — document date",
      "DocDueDate": "DateTime — delivery / due date",
      "TaxDate": "DateTime — tax posting date",
      "CardCode": "string — business partner code (FK → BusinessPartners.CardCode)",
      "CardName": "string — business partner name (denormalized)",
      "DocTotal": "decimal — document total in document currency",
      "VatSum": "decimal — total VAT amount",
      "DocCurrency": "string — document currency code",
      "DocRate": "decimal — exchange rate to local currency",
      "DiscountPercent": "decimal — header-level discount %",
      "Reference1": "string — customer/vendor reference",
      "Reference2": "string — secondary reference",
      "NumAtCard": "string — vendor/customer own doc number",
      "Comments": "string — remarks / notes",
      "JournalMemo": "string — GL posting memo",
      "SalesPersonCode": "int — FK → SalesPersons.SalesEmployeeCode",
      "TransportationCode": "int — shipping method code",
      "Series": "int — document numbering series",
      "DocumentStatus": "enum — 'bost_Open' | 'bost_Close'",
      "Cancelled": "enum — 'tYES' | 'tNO'",
      "CancelStatus": "enum — 'csNo' | 'csCancelledByCancellation'",
      "Address": "string — ship-to address block",
      "Address2": "string — bill-to address block",
      "ContactPersonCode": "int — contact person",
      "PaymentGroupCode": "int — payment terms group",
      "FinancialPeriod": "int — fiscal period number",
      "UserSign": "int — created-by user internal ID",
      "TransNum": "int — journal entry transaction number (null on quotations/requests)",
      "DocObjectCode": "string — entity type identifier (e.g. 'oOrders', 'oPurchaseOrders')",
      "CreationDate": "DateTime",
      "UpdateDate": "DateTime",
      "DocTotalSys": "decimal — total in local currency",
      "VatSumSys": "decimal — VAT in local currency"
    }
  },

  "commonDocumentLine": {
    "description": "Shared line fields on all document DocumentLines arrays",
    "fields": {
      "LineNum": "int — 0-based line index",
      "ItemCode": "string — FK → Items.ItemCode",
      "ItemDescription": "string — item name (denormalized)",
      "Quantity": "decimal — ordered/delivered quantity",
      "Price": "decimal — unit price (excl. VAT)",
      "UnitPrice": "decimal — same as Price (alias)",
      "PriceAfterVAT": "decimal — unit price including VAT",
      "DiscountPercent": "decimal — line discount %",
      "VatGroup": "string — VAT group code",
      "TaxPercentagePerRow": "decimal — effective tax %",
      "LineTotal": "decimal — Price × Quantity (excl. VAT)",
      "TaxTotal": "decimal — VAT amount for this line",
      "GrossTotal": "decimal — total including VAT",
      "WarehouseCode": "string — FK → Warehouses.WarehouseCode",
      "SalesPersonCode": "int — line-level salesperson (-1 = inherit from header)",
      "AccountCode": "string — GL account for this line",
      "CostingCode": "string — profit center / cost center",
      "ProjectCode": "string — project code",
      "BaseType": "int — source document type (see baseTypeCodes)",
      "BaseEntry": "int — source document DocEntry",
      "BaseLine": "int — source document LineNum",
      "LineStatus": "enum — 'bost_Open' | 'bost_Close'",
      "RemainingOpenQuantity": "decimal — unfulfilled quantity",
      "InventoryQuantity": "decimal — quantity in inventory UOM",
      "OpenAmount": "decimal — remaining open amount",
      "VendorNum": "string — vendor's part number",
      "SerialNum": "string — serial number on line",
      "ShipDate": "DateTime — requested ship date",
      "ActualDeliveryDate": "DateTime",
      "UoMCode": "string — unit of measure code",
      "TreeType": "string — BOM type ('iNotATree' = plain item)",
      "LineType": "enum — 'dlt_Regular' | 'dlt_Alternative'"
    }
  },

  "entities": {
    "Quotations": {
      "odataPath": "/Quotations",
      "sapTable": "OQUT / QUT1",
      "docObjectCode": "oQuotation",
      "description": "Sales Quotations — offers sent to customers before an order is placed",
      "uniqueFields": {
        "DocObjectCode": "'oQuotation'",
        "GrossProfit": "decimal — gross profit amount on quotation",
        "GrossProfitTotalBasePrice": "decimal",
        "RemainingOpenQuantity": "unfulfilled qty per line"
      },
      "commonFilters": [
        "DocumentStatus eq 'bost_Open'",
        "CardCode eq 'C001'",
        "DocDate ge '2025-01-01'",
        "SalesPersonCode eq 5"
      ],
      "joins": "Lines: DocumentLines[]; Link to Orders via BaseType=23, BaseEntry=DocEntry"
    },

    "Orders": {
      "odataPath": "/Orders",
      "sapTable": "ORDR / RDR1",
      "docObjectCode": "oOrders",
      "description": "Sales Orders — confirmed customer orders",
      "uniqueFields": {
        "PartialSupply": "'tYES' | 'tNO' — allows partial deliveries",
        "DocObjectCode": "'oOrders'"
      },
      "commonFilters": [
        "DocumentStatus eq 'bost_Open'",
        "Cancelled eq 'tNO'",
        "CardCode eq 'C001'"
      ],
      "joins": "Lines: DocumentLines[]; Created from Quotation (BaseType=23); Base for DeliveryNote (BaseType=17)"
    },

    "Invoices": {
      "odataPath": "/Invoices",
      "sapTable": "OINV / INV1",
      "docObjectCode": "oInvoices",
      "description": "AR Invoices — billed to customers",
      "uniqueFields": {
        "PaidToDate": "decimal — amount paid to date (local currency)",
        "PaidToDateFC": "decimal — amount paid (foreign currency)",
        "PaidToDateSys": "decimal — amount paid (system currency)",
        "InvoicePayment": "'tYES' | 'tNO'",
        "DocumentInstallments": "array of installment payment schedules"
      },
      "commonFilters": [
        "DocumentStatus eq 'bost_Open' and Cancelled eq 'tNO'",
        "PaidToDate lt DocTotal",
        "DocDueDate lt '2025-12-31'"
      ],
      "joins": "Lines: DocumentLines[]; Created from DeliveryNote (BaseType=15) or Order (BaseType=17)"
    },

    "DeliveryNotes": {
      "odataPath": "/DeliveryNotes",
      "sapTable": "ODLN / DLN1",
      "docObjectCode": "oDeliveryNotes",
      "description": "Sales Delivery Notes — goods issued to customer",
      "uniqueFields": {
        "DocObjectCode": "'oDeliveryNotes'"
      },
      "joins": "Created from Order (BaseType=17); Base for Invoice (BaseType=15)"
    },

    "CreditNotes": {
      "odataPath": "/CreditNotes",
      "sapTable": "ORIN / RIN1",
      "docObjectCode": "oCreditNotes",
      "description": "AR Credit Notes — customer returns / adjustments",
      "uniqueFields": {
        "DocObjectCode": "'oCreditNotes'",
        "ShipToCodeForReturn": "string",
        "AddressForReturn": "string",
        "ReturnAction": "string",
        "ReturnReason": "string (on lines)"
      }
    },

    "Returns": {
      "odataPath": "/Returns",
      "sapTable": "ORDN / RDN1",
      "docObjectCode": "oReturns",
      "description": "Sales Returns — goods returned from customer",
      "uniqueFields": {
        "DocObjectCode": "'oReturns'"
      }
    },

    "PurchaseOrders": {
      "odataPath": "/PurchaseOrders",
      "sapTable": "OPOR / POR1",
      "docObjectCode": "oPurchaseOrders",
      "description": "Purchase Orders — sent to vendors/suppliers",
      "uniqueFields": {
        "DocObjectCode": "'oPurchaseOrders'",
        "OpenForLandedCosts": "'tYES' | 'tNO'",
        "PartialSupply": "'tYES' | 'tNO'"
      },
      "commonFilters": [
        "DocumentStatus eq 'bost_Open'",
        "CardCode eq 'V001'",
        "DocDate ge '2025-01-01'"
      ],
      "joins": "Lines: DocumentLines[]; Base for GRPO (BaseType=22)"
    },

    "PurchaseDeliveryNotes": {
      "odataPath": "/PurchaseDeliveryNotes",
      "sapTable": "OPDN / PDN1",
      "docObjectCode": "oPurchaseDeliveryNotes",
      "description": "Goods Receipt PO (GRPO) — goods received from supplier",
      "uniqueFields": {
        "DocObjectCode": "'oPurchaseDeliveryNotes'",
        "TransNum": "int — GL transaction created on receipt",
        "WareHouseUpdateType": "'dwh_Stock' — stock is updated"
      },
      "commonFilters": [
        "DocumentStatus eq 'bost_Open' and Cancelled eq 'tNO'",
        "CardCode eq 'V001'",
        "DocDate ge '2025-01-01'"
      ],
      "joins": "Created from PurchaseOrder (BaseType=22); Base for PurchaseInvoice (BaseType=20)"
    },

    "PurchaseInvoices": {
      "odataPath": "/PurchaseInvoices",
      "sapTable": "OPCH / PCH1",
      "docObjectCode": "oPurchaseInvoices",
      "description": "AP Invoices — supplier invoices to be paid",
      "uniqueFields": {
        "PaidToDate": "decimal — amount paid to date",
        "PaidToDateFC": "decimal",
        "PaidToDateSys": "decimal",
        "InvoicePayment": "'tYES' | 'tNO'",
        "DocumentInstallments": "array of payment installments",
        "DocObjectCode": "'oPurchaseInvoices'"
      },
      "commonFilters": [
        "DocumentStatus eq 'bost_Open' and Cancelled eq 'tNO'",
        "PaidToDate lt DocTotal",
        "DocDueDate le '2025-12-31'"
      ],
      "joins": "Created from GRPO (BaseType=20) or PurchaseOrder (BaseType=22)"
    },

    "PurchaseQuotations": {
      "odataPath": "/PurchaseQuotations",
      "sapTable": "OPQT / PQT1",
      "docObjectCode": "oPurchaseQuotations",
      "description": "Purchase Quotations (RFQ) — price quotes requested from vendors",
      "uniqueFields": {
        "DocObjectCode": "'oPurchaseQuotations'",
        "RequriedDate": "DateTime — required delivery date",
        "GroupSeries": "int — quotation group series (for comparing multiple vendor quotes)",
        "GroupNumber": "int — quotation group number"
      },
      "joins": "Lines: DocumentLines[]; Created from PurchaseRequest (BaseType=1470000113)"
    },

    "PurchaseRequests": {
      "odataPath": "/PurchaseRequests",
      "sapTable": "OPRQ / PRQ1",
      "docObjectCode": "oPurchaseRequest",
      "description": "Purchase Requests (Internal PR) — internal requisitions before ordering",
      "uniqueFields": {
        "DocObjectCode": "'oPurchaseRequest'",
        "Requester": "string — requester employee ID",
        "RequesterName": "string — requester full name",
        "RequesterBranch": "int — branch code",
        "RequesterDepartment": "int — department code",
        "RequesterEmail": "string",
        "SendNotification": "'tYES' | 'tNO'",
        "ReqType": "int — request type",
        "ReqCode": "string — requester code",
        "LineVendor": "string (on lines) — suggested vendor per line"
      },
      "commonFilters": [
        "DocumentStatus eq 'bost_Open'",
        "RequriedDate ge '2025-01-01'"
      ],
      "joins": "Lines: DocumentLines[]; Base for PurchaseQuotation (BaseType=1470000113)"
    },

    "BusinessPartners": {
      "odataPath": "/BusinessPartners",
      "sapTable": "OCRD",
      "description": "Business Partners — customers, suppliers, leads",
      "fields": {
        "CardCode": "string — unique BP code (PK)",
        "CardName": "string — full name",
        "CardType": "enum — 'cCustomer' | 'cSupplier' | 'cLead'",
        "GroupCode": "int — FK → BusinessPartnerGroups.Code",
        "Phone1": "string",
        "EmailAddress": "string",
        "CreditLimit": "decimal",
        "SalesPersonCode": "int — default salesperson",
        "Currency": "string — default currency",
        "CurrentAccountBalance": "decimal — current open balance",
        "OpenDeliveryNotesBalance": "decimal",
        "OpenOrdersBalance": "decimal",
        "Valid": "enum — 'tYES' | 'tNO'",
        "Frozen": "enum — 'tYES' | 'tNO'",
        "PriceListNum": "int — default price list",
        "PayTermsGrpCode": "int — payment terms",
        "DiscountPercent": "decimal",
        "HouseBank": "string",
        "BankCountry": "string",
        "DebitorAccount": "string — AR control account",
        "DunningTerm": "string",
        "CompanyPrivate": "enum — 'cCompany' | 'cPrivate'"
      },
      "commonFilters": [
        "CardType eq 'cCustomer'",
        "CardType eq 'cSupplier'",
        "Valid eq 'tYES' and Frozen eq 'tNO'",
        "contains(CardName,'smith')"
      ]
    },

    "SalesPersons": {
      "odataPath": "/SalesPersons",
      "sapTable": "OSLP",
      "description": "Sales Employees / Sales Persons",
      "fields": {
        "SalesEmployeeCode": "int — PK",
        "SalesEmployeeName": "string",
        "CommissionForSalesEmployee": "decimal — commission %",
        "CommissionGroup": "int",
        "Locked": "enum — 'tYES' | 'tNO'",
        "Active": "enum — 'tYES' | 'tNO'",
        "Telephone": "string",
        "Mobile": "string",
        "Email": "string"
      }
    },

    "Items": {
      "odataPath": "/Items",
      "sapTable": "OITM",
      "description": "Item Master Data — products, services, raw materials",
      "fields": {
        "ItemCode": "string — unique item code (PK)",
        "ItemName": "string — description",
        "ForeignName": "string — foreign language name",
        "ItemsGroupCode": "int — FK → ItemGroups.Number",
        "PurchaseItem": "enum — 'tYES'|'tNO'",
        "SalesItem": "enum — 'tYES'|'tNO'",
        "InventoryItem": "enum — 'tYES'|'tNO'",
        "QuantityOnStock": "decimal — total on-hand across all warehouses",
        "QuantityOrderedFromVendors": "decimal — on order from suppliers",
        "QuantityOrderedByCustomers": "decimal — committed to customers",
        "MinInventory": "decimal — minimum/reorder level",
        "MaxInventory": "decimal — maximum inventory level",
        "DesiredInventory": "decimal — target inventory",
        "DefaultWarehouse": "string — FK → Warehouses.WarehouseCode",
        "Mainsupplier": "string — default vendor CardCode",
        "InventoryUOM": "string — base unit of measure",
        "CostAccountingMethod": "enum — 'bis_MovingAverage' | 'bis_Standard' | 'bis_FIFO'",
        "PlanningSystem": "enum — 'bop_MRP' | 'bop_None'",
        "ProcurementMethod": "enum — 'bom_Buy' | 'bom_Make'",
        "LeadTime": "int — replenishment lead time in days",
        "MinOrderQuantity": "decimal — minimum order quantity",
        "OrderMultiple": "decimal — order in multiples of this",
        "ManageSerialNumbers": "enum — 'tYES'|'tNO'",
        "ManageBatchNumbers": "enum — 'tYES'|'tNO'",
        "Valid": "enum — 'tYES'|'tNO'",
        "Frozen": "enum — 'tYES'|'tNO'",
        "SalesVATGroup": "string — VAT group for sales",
        "PurchaseVATGroup": "string — VAT group for purchases",
        "ItemType": "enum — 'itItems' | 'itLabor' | 'itTravel'",
        "ItemClass": "enum — 'itcMaterial' | 'itcService' | 'itcFixedAssets'",
        "MaterialType": "enum — 'mt_FinishedGoods' | 'mt_RawMaterial' | 'mt_WIP'",
        "BarCode": "string",
        "UpdateDate": "DateTime",
        "CreateDate": "DateTime"
      },
      "commonFilters": [
        "SalesItem eq 'tYES' and Valid eq 'tYES'",
        "PurchaseItem eq 'tYES' and Frozen eq 'tNO'",
        "ItemsGroupCode eq 100",
        "contains(ItemName,'pump')",
        "ItemCode eq 'A00001'"
      ],
      "notes": "Use /Items('{ItemCode}') for single-item lookup. QuantityOnStock is total across all warehouses; use ItemWarehouseInfoCollection or /ItemWarehouseInfos for per-warehouse stock."
    },

    "ItemGroups": {
      "odataPath": "/ItemGroups",
