{
  "name": "sap-b1-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for SAP Business One Order-to-Cash automation via the Service Layer API.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm src/server.ts",
    "chat": "node chat-server.mjs",
    "start:ui-connector": "node dist/ui-connector-server.js",
    "dev:ui-connector": "node --loader ts-node/esm src/ui-connector-server.ts",
    "api": "cd fastapi_app && set PYTHONIOENCODING=utf-8 && python main.py"
  },
  "keywords": [
    "mcp",
    "sap-business-one",
    "sap-b1",
    "service-layer",
    "order-to-cash"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "node-windows": "^1.0.0-beta.8",
    "@anthropic-ai/sdk": "^0.87.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.9.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "hdb": "^2.27.1",
    "imap": "^0.8.19",
    "mailparser": "^3.9.8",
    "mssql": "^12.2.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
